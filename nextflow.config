manifest {
    name = 'zebrafish-rnaseq-workshop'
    version = '1.0.0'
}

process {
    executor = 'local'
    cpus = 4
    memory = '8 GB'
    errorStrategy = 'terminate'
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_report.html"
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_timeline.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_trace.txt"
}
